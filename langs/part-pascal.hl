context pascal nocase
  match '{$' => preproc push pas_directive
  match '{' => comment push pas_brace
  match '(*$' => preproc push pas_directive_paren
  match '(*' => comment push pas_paren
  match /\/\/.*/ => comment
  match /'(?:[^']|'')*'/ => string
  match /'.*/ => string
  match /#(?:\d+|\$[0-9A-Fa-f]+)/ => string
  match /\basm\b/ => keyword push pas_asm
  words keyword and array as begin case class const constructor destructor div do downto else end except exports file finally for function goto if implementation in inherited initialization inline interface is label library mod nil not object of on or out packed procedure program property raise record repeat set shl shr string then threadvar to try type unit until uses var while with xor private protected public published strict override virtual abstract overload reintroduce static cdecl stdcall register assembler forward external default index read write stored nodefault implements dynamic message resourcestring operator generic specialization
  words type boolean byte char integer longint longword int64 qword pointer real double single extended shortint smallint word widechar ansistring unicodestring pchar comp currency cardinal shortstring widestring text tobject
  words builtin writeln write readln read new dispose inc dec length setlength copy pos ord chr sizeof high low true false assigned exit break continue halt abs sqr sqrt odd succ pred upcase fillchar move getmem freemem
  number pascal
  ops +-*/<>=:^@
context pas_directive default preproc nocase
  match '}' => preproc pop
context pas_directive_paren default preproc nocase
  match '*)' => preproc pop
context pas_brace default comment nocase
  match '}' => comment pop
context pas_paren default comment nocase
  match '*)' => comment pop
context pas_asm default asm nocase
  match /\bend\b/ => keyword pop
  match '{' => comment push pas_brace
  match '(*' => comment push pas_paren
  match /\/\/.*/ => comment
  match /'[^']*'/ => string
  number pascal
