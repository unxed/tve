language Smarty (HTML, CSS, JavaScript)
masks *.tpl
start html
inject smarty
ident _$
symbol 1 /(?i)^\s*<h1\b[^>]*>\s*([^<]+)/
symbol 2 /(?i)^\s*<h2\b[^>]*>\s*([^<]+)/
symbol 3 /(?i)^\s*<h3\b[^>]*>\s*([^<]+)/
symbol 4 /(?i)^\s*<h4\b[^>]*>\s*([^<]+)/
symbol 5 /(?i)^\s*<h5\b[^>]*>\s*([^<]+)/
symbol 6 /(?i)^\s*<h6\b[^>]*>\s*([^<]+)/
symbol 2 /^\s*\{(?:block|function)\s+(?:name\s*=\s*)?["']?([\w-]+)/
outline regions
fold /(?i)<(?:html|head|body|div|section|article|nav|header|footer|main|aside|ul|ol|table|thead|tbody|tfoot|form|fieldset|select|script|style|pre|blockquote|dl|details|figure|template|svg|noscript|textarea)\b/ /(?i)<\/(?:html|head|body|div|section|article|nav|header|footer|main|aside|ul|ol|table|thead|tbody|tfoot|form|fieldset|select|script|style|pre|blockquote|dl|details|figure|template|svg|noscript|textarea)\s*>/
fold /\{(?:if|foreach|section|block|capture|function|literal|strip|for|while)\b/ /\{\/(?:if|foreach|section|block|capture|function|literal|strip|for|while)\b/
%include part-html
%include part-js
%include part-css
%include part-smarty
