context py
  match /#.*/ => comment
  match '"""' => string push py_tq_dq
  match "'''" => string push py_tq_sq
  match '"' => string push py_dq
  match "'" => string push py_sq
  match /@[A-Za-z_][\w.]*/ => preproc
  words keyword and as assert async await break class continue def del elif else except finally for from global if import in is lambda nonlocal not or pass raise return try while with yield match case
  words type int str float bool list dict set tuple bytes object type
  words builtin print len range True False None self cls open isinstance super enumerate zip map filter sorted
  number c
  ops +-*/<>=!&|^~%:.@
context py_tq_dq default string
  match /\\./ => escape
  match '"""' => string pop
context py_tq_sq default string
  match /\\./ => escape
  match "'''" => string pop
context py_dq default string eolpop
  match /\\./ => escape
  match '"' => string pop
context py_sq default string eolpop
  match /\\./ => escape
  match "'" => string pop
