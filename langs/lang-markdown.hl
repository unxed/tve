language Markdown
masks *.md *.markdown
start md
ident _$
symbol 1 /^#\s+(.+?)\s*#*\s*$/
symbol 2 /^##\s+(.+?)\s*#*\s*$/
symbol 3 /^###\s+(.+?)\s*#*\s*$/
symbol 4 /^####\s+(.+?)\s*#*\s*$/
symbol 5 /^#####\s+(.+?)\s*#*\s*$/
symbol 6 /^######\s+(.+?)\s*#*\s*$/
fold outline
%include part-markdown
%include part-pascal
%include part-go
%include part-c
%include part-js
%include part-css
%include part-html
%include part-sh
%include part-python
%include part-json
%include part-sql
%include part-yaml
%include part-diff
%include part-ini
%include part-make
