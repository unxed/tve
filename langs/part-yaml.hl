context yaml
  match /(?:^|\s)#.*/ => comment
  # a block scalar (key: | or key: >): the lines after it that are indented more than the key are text
  match /^([A-Za-z_][\w.\/ -]*?)(\s*:\s*)([|>][+-]?\d*)(?=\s*(?:#.*)?$)/ => property delimiter operator push yaml_block0
  match /^([ -]{1})([A-Za-z_][\w.\/ -]*?)(\s*:\s*)([|>][+-]?\d*)(?=\s*(?:#.*)?$)/ => delimiter property delimiter operator push yaml_block1
  match /^([ -]{2})([A-Za-z_][\w.\/ -]*?)(\s*:\s*)([|>][+-]?\d*)(?=\s*(?:#.*)?$)/ => delimiter property delimiter operator push yaml_block2
  match /^([ -]{3})([A-Za-z_][\w.\/ -]*?)(\s*:\s*)([|>][+-]?\d*)(?=\s*(?:#.*)?$)/ => delimiter property delimiter operator push yaml_block3
  match /^([ -]{4})([A-Za-z_][\w.\/ -]*?)(\s*:\s*)([|>][+-]?\d*)(?=\s*(?:#.*)?$)/ => delimiter property delimiter operator push yaml_block4
  match /^([ -]{5})([A-Za-z_][\w.\/ -]*?)(\s*:\s*)([|>][+-]?\d*)(?=\s*(?:#.*)?$)/ => delimiter property delimiter operator push yaml_block5
  match /^([ -]{6})([A-Za-z_][\w.\/ -]*?)(\s*:\s*)([|>][+-]?\d*)(?=\s*(?:#.*)?$)/ => delimiter property delimiter operator push yaml_block6
  match /^([ -]{7})([A-Za-z_][\w.\/ -]*?)(\s*:\s*)([|>][+-]?\d*)(?=\s*(?:#.*)?$)/ => delimiter property delimiter operator push yaml_block7
  match /^([ -]{8})([A-Za-z_][\w.\/ -]*?)(\s*:\s*)([|>][+-]?\d*)(?=\s*(?:#.*)?$)/ => delimiter property delimiter operator push yaml_block8
  match /^([ -]{9})([A-Za-z_][\w.\/ -]*?)(\s*:\s*)([|>][+-]?\d*)(?=\s*(?:#.*)?$)/ => delimiter property delimiter operator push yaml_block9
  match /^([ -]{10})([A-Za-z_][\w.\/ -]*?)(\s*:\s*)([|>][+-]?\d*)(?=\s*(?:#.*)?$)/ => delimiter property delimiter operator push yaml_block10
  match /^([ -]{11})([A-Za-z_][\w.\/ -]*?)(\s*:\s*)([|>][+-]?\d*)(?=\s*(?:#.*)?$)/ => delimiter property delimiter operator push yaml_block11
  match /^([ -]{12})([A-Za-z_][\w.\/ -]*?)(\s*:\s*)([|>][+-]?\d*)(?=\s*(?:#.*)?$)/ => delimiter property delimiter operator push yaml_block12
  match /^([ -]{13})([A-Za-z_][\w.\/ -]*?)(\s*:\s*)([|>][+-]?\d*)(?=\s*(?:#.*)?$)/ => delimiter property delimiter operator push yaml_block13
  match /^([ -]{14})([A-Za-z_][\w.\/ -]*?)(\s*:\s*)([|>][+-]?\d*)(?=\s*(?:#.*)?$)/ => delimiter property delimiter operator push yaml_block14
  match /^([ -]{15})([A-Za-z_][\w.\/ -]*?)(\s*:\s*)([|>][+-]?\d*)(?=\s*(?:#.*)?$)/ => delimiter property delimiter operator push yaml_block15
  match /^([ -]{16})([A-Za-z_][\w.\/ -]*?)(\s*:\s*)([|>][+-]?\d*)(?=\s*(?:#.*)?$)/ => delimiter property delimiter operator push yaml_block16
  match /^(?:---|\.\.\.)(?=\s|$)/ => delimiter
  match /^(\s*(?:-\s+)*)("(?:[^"\\]|\\.)*"|'[^']*')(\s*:)(?=\s|$)/ => delimiter string delimiter
  match /^(\s*(?:-\s+)*)([A-Za-z_][\w.\/ -]*?)(\s*:)(?=\s|$)/ => delimiter property delimiter
  match /^\s*-(?=\s|$)/ => delimiter
  match '"' => string push yaml_dq
  match "'" => string push yaml_sq
  match /[&*][A-Za-z_][\w-]*/ => variable
  match /![\w!<>:\/.-]*/ => type
  match /[|>][+-]?(?=\s*$)/ => operator
  words keyword true false null True False TRUE FALSE Null NULL yes no on off Yes No
  number c
  ops :,[]{}
context yaml_dq default string
  match /\\./ => escape
  match '"' => string pop
context yaml_sq default string
  match "''" => escape
  match "'" => string pop
context yaml_block0 default string
  match /^(?=\S)/ => normal pop
context yaml_block1 default string
  match /^(?= {0,1}\S)/ => normal pop
context yaml_block2 default string
  match /^(?= {0,2}\S)/ => normal pop
context yaml_block3 default string
  match /^(?= {0,3}\S)/ => normal pop
